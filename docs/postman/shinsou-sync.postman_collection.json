          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices/{{deviceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "devices",
                "{{deviceId}}"
              ],
              "query": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sync",
      "item": [
        {
          "name": "Push",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sync/push",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sync",
                "push"
              ],
              "query": []
            },
            "description": "Merges one library record and one unit record. 410 resync_required means: pull again with since=0.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batchId\": \"{{batchId}}\",\n  \"since\": {{since}},\n  \"works\": [\n    {\n      \"keyVersion\": 1,\n      \"packageId\": \"{{packageId}}\",\n      \"sourceId\": \"{{sourceId}}\",\n      \"remoteId\": \"{{remoteId}}\",\n      \"hash\": \"{{workHash}}\",\n      \"title\": \"Example work\",\n      \"author\": \"Example author\",\n      \"contentKind\": \"novel\"\n    }\n  ],\n  \"records\": [\n    {\n      \"kind\": \"library\",\n      \"key\": \"{{workHash}}\",\n      \"fields\": { \"pinned\": true, \"addedAt\": 1731200000000 },\n      \"clocks\": { \"pinned\": \"{{clock}}\", \"addedAt\": \"{{clock}}\" }\n    },\n    {\n      \"kind\": \"unit\",\n      \"key\": \"{{unitHash}}\",\n      \"work\": \"{{workHash}}\",\n      \"unitRemoteId\": \"{{unitRemoteId}}\",\n      \"fields\": { \"read\": true },\n      \"clocks\": { \"read\": \"{{clock}}\" }\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Work key v1 (docs/spec/work-key.md): length-prefixed canonical string, SHA-256 hex.",
                  "const lp = (s) => Buffer.byteLength(s, 'utf8') + ':' + s;",
                  "const pkg = pm.collectionVariables.get('packageId'), src = pm.collectionVariables.get('sourceId'), rid = pm.collectionVariables.get('remoteId'), unit = pm.collectionVariables.get('unitRemoteId');",
                  "pm.collectionVariables.set('workHash', CryptoJS.SHA256('w1|' + lp(pkg) + lp(src) + lp(rid)).toString());",
                  "pm.collectionVariables.set('unitHash', CryptoJS.SHA256('u1|' + lp(pkg) + lp(src) + lp(rid) + lp(unit)).toString());",
                  "pm.collectionVariables.set('batchId', require('uuid').v4());",
                  "pm.collectionVariables.set('clock', Date.now() + ':0:' + pm.collectionVariables.get('syncDeviceId'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('since', 0); // keep pulling from the start in this demo",
                  "pm.test('records applied or unchanged', () => j.results.every(r => ['applied','unchanged'].includes(r.result)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Changes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sync/changes?since={{since}}&limit=500",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sync",
                "changes"
              ],
              "query": [
                {
                  "key": "since",
                  "value": "{{since}}"
                },
                {
                  "key": "limit",
                  "value": "500"
                }
              ]
            },
            "description": "Stores nextSince as the new cursor."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('since', j.nextSince);"
                ]
              }
            }
          ]
        },
        {
          "name": "Changes from the start",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sync/changes?since=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sync",
                "changes"
              ],
              "query": [
                {
                  "key": "since",
                  "value": "0"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stream (SSE)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sync/stream",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sync",
                "stream"
              ],
              "query": []
            },
            "description": "Server-sent events: data: {\"seq\":N}. Postman cannot hold a WebSocket here; the WebSocket form is the same URL with an Upgrade request."
          }
        }
      ]
    }
  ]
}