{
  "info": {
    "name": "Shinsou Sync API",
    "description": "P1 server endpoints (api/openapi.yaml). Run Register or Login first; the test scripts store the tokens. Requires a server at {{baseUrl}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Shinsou-Api-Version', value: '1' });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "username",
      "value": "demo_user"
    },
    {
      "key": "password",
      "value": "correct horse battery"
    },
    {
      "key": "newPassword",
      "value": "a brand new password"
    },
    {
      "key": "inviteCode",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "deviceId",
      "value": ""
    },
    {
      "key": "syncDeviceId",
      "value": "postman"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "since",
      "value": "0"
    },
    {
      "key": "packageId",
      "value": "zh.wenku8"
    },
    {
      "key": "sourceId",
      "value": "zh.wenku8"
    },
    {
      "key": "remoteId",
      "value": "1973"
    },
    {
      "key": "unitRemoteId",
      "value": "chapter-1"
    },
    {
      "key": "workHash",
      "value": ""
    },
    {
      "key": "unitHash",
      "value": ""
    },
    {
      "key": "batchId",
      "value": ""
