# --- Required ------------------------------------------------------------------------------
# The address people will open, exactly as the browser shows it. Your own reverse proxy serves
# it over HTTPS and forwards to the port below. For a trial run on your own computer use
# http://localhost:8080 and no proxy.
SHINSOU_PUBLIC_URL=https://sync.example.com
# Password of the bundled PostgreSQL. Pick a long random one; letters and digits only keeps it
# safe inside the connection string (for example: openssl rand -hex 24).
POSTGRES_PASSWORD=change-me

# --- Optional ------------------------------------------------------------------------------
# Who may register: open | invite | closed. Administrators can change it later in the web console.
SHINSOU_REGISTRATION=invite
SHINSOU_INSTANCE_NAME=Shinsou Sync
# Leave empty for the default: "required" when SMTP is configured and registration is open,
# otherwise "disabled". Or set disabled | optional | required.
SHINSOU_EMAIL_VERIFICATION=
# Records one account may store (0 = unlimited).
SHINSOU_RECORD_QUOTA=200000
# Sharing works between accounts on this server: enabled | disabled.
SHINSOU_SHARING=enabled
# Shares one account may create in 24 hours (0 = unlimited).
SHINSOU_SHARES_PER_DAY=200
# Reviews of works: enabled | disabled.
SHINSOU_REVIEWS=enabled
# Let people who are not signed in read work pages and reviews: enabled | disabled.
SHINSOU_VISITOR_BROWSING=disabled

# Mail for address verification and password reset. Leave SHINSOU_SMTP_HOST empty to run without.
SHINSOU_SMTP_HOST=
SHINSOU_SMTP_PORT=587
SHINSOU_SMTP_USERNAME=
SHINSOU_SMTP_PASSWORD=
SHINSOU_SMTP_FROM=Shinsou <no-reply@example.com>
# starttls (587) | implicit (465) | none
SHINSOU_SMTP_TLS=starttls

# Where the server listens on this host (plain HTTP, for your reverse proxy).
#SHINSOU_PORT=8080
# Keep 127.0.0.1 when the proxy runs on this host; 0.0.0.0 only behind a firewall.
#SHINSOU_BIND=127.0.0.1
# Addresses whose X-Forwarded-For is trusted (comma-separated CIDRs). The default is the gateway
# of the Compose network, which is where a proxy on this host connects from.
#SHINSOU_TRUSTED_PROXIES=172.30.42.1/32
# Version string shown by the server; set when building, e.g. $(git describe --tags --always).
#SHINSOU_VERSION=dev
