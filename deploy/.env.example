POSTGRES_PASSWORD=change-me
# The address people open in a browser. Required behind the TLS-terminating proxy: the web front
# end's sign-in is refused (403 csrf_failed) when the browser's origin does not match it.
SHINSOU_PUBLIC_URL=https://sync.example.com
SHINSOU_REGISTRATION=invite
# Leave empty for the default: "required" when SMTP is configured and registration is open,
# otherwise "disabled". Or set disabled | optional | required.
SHINSOU_EMAIL_VERIFICATION=
SHINSOU_INSTANCE_NAME=Shinsou Sync
# Reverse proxy address(es) whose X-Forwarded-For header may be trusted, e.g. 172.16.0.0/12
SHINSOU_TRUSTED_PROXIES=
SHINSOU_RECORD_QUOTA=200000
# Mail for address verification and password reset. Leave SHINSOU_SMTP_HOST empty to disable.
# SHINSOU_PUBLIC_URL (above) must then be the public https address: mail links are built from it.
SHINSOU_SMTP_HOST=
SHINSOU_SMTP_PORT=587
SHINSOU_SMTP_USERNAME=
SHINSOU_SMTP_PASSWORD=
SHINSOU_SMTP_FROM=Shinsou <no-reply@example.com>
# starttls (587) | implicit (465) | none
SHINSOU_SMTP_TLS=starttls
